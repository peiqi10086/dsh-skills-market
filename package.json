{
  "name": "dsh-skills-market",
  "version": "0.2.0",
  "description": "DSH skills manager + SkillHub marketplace: manage user-level/per-workspace skills and search/install skills from SkillHub in a Web UI panel",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "skills",
    "skillhub",
    "marketplace"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/local.spec.ts tests/skillhub.spec.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-better-sidebar": "*"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "fflate": "^0.8.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.5.0"
  }
}
